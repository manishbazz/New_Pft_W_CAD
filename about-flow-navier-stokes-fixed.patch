+"use client";
+
+import { useEffect, useRef } from "react";
+
+const NX = 96;
+const NY = 48;
+const SIZE = NX * NY;
+const DT = 0.075;
+const VISCOSITY = 0.00045;
+const PRESSURE_ITERATIONS = 6;
+const STEPS_PER_FRAME = 2;
+
+function clamp(value: number, min: number, max: number) {
+  return Math.max(min, Math.min(max, value));
+}
+
+function index(x: number, y: number) {
+  return x + y * NX;
+}
+
+function sample(field: Float32Array, x: number, y: number) {
+  const xx = clamp(x, 0, NX - 1.001);
+  const yy = clamp(y, 0, NY - 1.001);
+  const x0 = Math.floor(xx);
+  const y0 = Math.floor(yy);
+  const x1 = Math.min(x0 + 1, NX - 1);
+  const y1 = Math.min(y0 + 1, NY - 1);
+  const tx = xx - x0;
+  const ty = yy - y0;
+  const a = field[index(x0, y0)];
+  const b = field[index(x1, y0)];
+  const c = field[index(x0, y1)];
+  const d = field[index(x1, y1)];
+  return a + (b - a) * tx + (c - a) * ty + (a - b - c + d) * tx * ty;
+}
+
+type FlowSimulationProps = {
+  active?: boolean;
+};
+
+/**
+ * Low-resolution 2D incompressible Navier–Stokes visualisation.
+ *
+ * It uses a semi-Lagrangian velocity advection step, viscous diffusion and
+ * pressure projection. The cylinder is a no-slip obstacle and the inlet is
+ * continuously restored to a uniform left-to-right velocity.
+ */
+export function FlowSimulation({ active = true }: FlowSimulationProps) {
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+  const wrapperRef = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    const wrapper = wrapperRef.current;
+    if (!canvas || !wrapper) return;
+
+    const ctx = canvas.getContext("2d");
+    if (!ctx) return;
+
+    const u = new Float32Array(SIZE);
+    const v = new Float32Array(SIZE);
+    const uPrev = new Float32Array(SIZE);
+    const vPrev = new Float32Array(SIZE);
+    const pressure = new Float32Array(SIZE);
+    const divergence = new Float32Array(SIZE);
+    const particles = Array.from({ length: 170 }, (_, i) => ({
+      x: (i / 170) * (NX - 2) + 1,
+      y: 1 + ((i * 17) % (NY - 2)),
+      age: i / 170,
+    }));
+
+    let animationFrame = 0;
+    let running = true;
+    let width = 1;
+    let height = 1;
+    let scaleX = 1;
+    let scaleY = 1;
+    let radius = 7;
+    let targetX = NX * 0.42;
+    let targetY = NY * 0.5;
+    let bodyX = targetX;
+    let bodyY = targetY;
+    let reducedMotion = false;
+
+    const resize = () => {
+      const rect = wrapper.getBoundingClientRect();
+      width = Math.max(1, Math.floor(rect.width));
+      height = Math.max(1, Math.floor(rect.height));
+      const dpr = Math.min(window.devicePixelRatio || 1, 2);
+      canvas.width = Math.floor(width * dpr);
+      canvas.height = Math.floor(height * dpr);
+      canvas.style.width = `${width}px`;
+      canvas.style.height = `${height}px`;
+      scaleX = width / NX;
+      scaleY = height / NY;
+      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+      radius = Math.max(5, Math.min(9, NX * 0.075));
+    };
+
+    const isSolid = (x: number, y: number) => {
+      const dx = x - bodyX;
+      const dy = y - bodyY;
+      return dx * dx + dy * dy <= radius * radius;
+    };
+
+    const resetInlet = () => {
+      for (let y = 0; y < NY; y++) {
+        const i = index(0, y);
+        u[i] = 0.72;
+        v[i] = 0;
+      }
+    };
+
+    const applyObstacle = () => {
+      for (let y = 1; y < NY - 1; y++) {
+        for (let x = 1; x < NX - 1; x++) {
+          if (!isSolid(x, y)) continue;
+          const i = index(x, y);
+          u[i] = 0;
+          v[i] = 0;
+        }
+      }
+    };
+
+    const step = () => {
+      bodyX += (targetX - bodyX) * 0.18;
+      bodyY += (targetY - bodyY) * 0.18;
+
+      uPrev.set(u);
+      vPrev.set(v);
+
+      // Semi-Lagrangian advection: trace each velocity component backwards.
+      for (let y = 1; y < NY - 1; y++) {
+        for (let x = 1; x < NX - 1; x++) {
+          const i = index(x, y);
+          if (isSolid(x, y)) {
+            u[i] = 0;
+            v[i] = 0;
+            continue;
+          }
+          const px = x - uPrev[i] * DT;
+          const py = y - vPrev[i] * DT;
+          u[i] = sample(uPrev, px, py);
+          v[i] = sample(vPrev, px, py);
+        }
+      }
+
+      // Viscous diffusion using a cheap explicit Laplacian.
+      for (let y = 1; y < NY - 1; y++) {
+        for (let x = 1; x < NX - 1; x++) {
+          const i = index(x, y);
+          if (isSolid(x, y)) continue;
+          const lapU =
+            u[index(x - 1, y)] + u[index(x + 1, y)] +
+            u[index(x, y - 1)] + u[index(x, y + 1)] - 4 * u[i];
+          const lapV =
+            v[index(x - 1, y)] + v[index(x + 1, y)] +
+            v[index(x, y - 1)] + v[index(x, y + 1)] - 4 * v[i];
+          u[i] += VISCOSITY * lapU;
+          v[i] += VISCOSITY * lapV;
+        }
+      }
+
+      // Pressure projection enforces div(u)=0.
+      pressure.fill(0);
+      for (let y = 1; y < NY - 1; y++) {
+        for (let x = 1; x < NX - 1; x++) {
+          const i = index(x, y);
+          divergence[i] = -0.5 * (
+            u[index(x + 1, y)] - u[index(x - 1, y)] +
+            v[index(x, y + 1)] - v[index(x, y - 1)]
+          );
+        }
+      }
+
+      for (let iter = 0; iter < PRESSURE_ITERATIONS; iter++) {
+        for (let y = 1; y < NY - 1; y++) {
+          for (let x = 1; x < NX - 1; x++) {
+            const i = index(x, y);
+            if (isSolid(x, y)) {
+              pressure[i] = 0;
+              continue;
+            }
+            pressure[i] = (
+              divergence[i] +
+              pressure[index(x - 1, y)] +
+              pressure[index(x + 1, y)] +
+              pressure[index(x, y - 1)] +
+              pressure[index(x, y + 1)]
+            ) * 0.25;
+          }
+        }
+      }
+
+      for (let y = 1; y < NY - 1; y++) {
+        for (let x = 1; x < NX - 1; x++) {
+          const i = index(x, y);
+          if (isSolid(x, y)) {
+            u[i] = 0;
+            v[i] = 0;
+            continue;
+          }
+          u[i] -= 0.5 * (pressure[index(x + 1, y)] - pressure[index(x - 1, y)]);
+          v[i] -= 0.5 * (pressure[index(x, y + 1)] - pressure[index(x, y - 1)]);
+        }
+      }
+
+      // Left inlet, open-ish right outlet, far-field top/bottom.
+      for (let y = 0; y < NY; y++) {
+        u[index(0, y)] = 0.72;
+        v[index(0, y)] = 0;
+        u[index(NX - 1, y)] = u[index(NX - 2, y)];
+        v[index(NX - 1, y)] = v[index(NX - 2, y)];
+      }
+      for (let x = 0; x < NX; x++) {
+        u[index(x, 0)] = u[index(x, 1)];
+        u[index(x, NY - 1)] = u[index(x, NY - 2)];
+        v[index(x, 0)] = 0;
+        v[index(x, NY - 1)] = 0;
+      }
+      applyObstacle();
+    };
+
+    const draw = () => {
+      ctx.clearRect(0, 0, width, height);
+      ctx.globalAlpha = 1;
+      ctx.lineWidth = 1;
+      ctx.strokeStyle = "rgba(140, 160, 175, 0.48)";
+
+      // Streamlines are traced from evenly spaced inlet seeds through the
+      // current velocity field. They are visual streamlines, not particles.
+      for (let seed = 2; seed < NY - 2; seed += 2.6) {
+        ctx.beginPath();
+        let x = 0.8;
+        let y = seed;
+        let started = false;
+        for (let n = 0; n < 150; n++) {
+          if (x >= NX - 1 || y <= 0.5 || y >= NY - 1.5 || isSolid(x, y)) break;
+          const vx = sample(u, x, y);
+          const vy = sample(v, x, y);
+          const speed = Math.hypot(vx, vy) || 0.001;
+          const px = x * scaleX;
+          const py = y * scaleY;
+          if (!started) {
+            ctx.moveTo(px, py);
+            started = true;
+          } else {
+            ctx.lineTo(px, py);
+          }
+          x += (vx / speed) * 0.7;
+          y += (vy / speed) * 0.7;
+        }
+        if (started) ctx.stroke();
+      }
+
+      // Moving tracer particles reinforce the left-to-right direction.
+      ctx.fillStyle = "rgba(220, 225, 230, 0.7)";
+      for (const particle of particles) {
+        const vx = sample(u, particle.x, particle.y);
+        const vy = sample(v, particle.x, particle.y);
+        particle.x += vx * 1.8;
+        particle.y += vy * 1.8;
+        particle.age += 0.008;
+        if (
+          particle.x > NX - 1 ||
+          particle.y < 1 ||
+          particle.y > NY - 2 ||
+          isSolid(particle.x, particle.y)
+        ) {
+          particle.x = 1;
+          particle.y = 1 + ((particle.y * 13.7) % (NY - 2));
+          particle.age = 0;
+        }
+        const size = 0.8 + Math.sin(particle.age * Math.PI * 2) * 0.25;
+        ctx.beginPath();
+        ctx.arc(particle.x * scaleX, particle.y * scaleY, size, 0, Math.PI * 2);
+        ctx.fill();
+      }
+
+      // The controlled circular body.
+      ctx.beginPath();
+      ctx.arc(bodyX * scaleX, bodyY * scaleY, radius * scaleX, 0, Math.PI * 2);
+      ctx.fillStyle = "rgba(12, 15, 18, 0.95)";
+      ctx.fill();
+      ctx.lineWidth = 1.25;
+      ctx.strokeStyle = "rgba(190, 200, 208, 0.75)";
+      ctx.stroke();
+    };
+
+    const pointerMove = (event: PointerEvent) => {
+      const rect = canvas.getBoundingClientRect();
+      targetX = clamp((event.clientX - rect.left) / scaleX, radius + 4, NX - radius - 5);
+      targetY = clamp((event.clientY - rect.top) / scaleY, radius + 4, NY - radius - 4);
+    };
+
+    const onVisibility = () => {
+      running = !document.hidden && active;
+    };
+
+    const observer = new ResizeObserver(resize);
+    observer.observe(wrapper);
+    resize();
+    canvas.addEventListener("pointermove", pointerMove);
+    document.addEventListener("visibilitychange", onVisibility);
+
+    const media = window.matchMedia("(prefers-reduced-motion: reduce)");
+    reducedMotion = media.matches;
+    const onMotionChange = () => {
+      reducedMotion = media.matches;
+    };
+    media.addEventListener?.("change", onMotionChange);
+
+    const frame = () => {
+      if (running && !reducedMotion) {
+        for (let i = 0; i < STEPS_PER_FRAME; i++) step();
+      }
+      draw();
+      animationFrame = window.requestAnimationFrame(frame);
+    };
+    frame();
+
+    return () => {
+      window.cancelAnimationFrame(animationFrame);
+      observer.disconnect();
+      canvas.removeEventListener("pointermove", pointerMove);
+      document.removeEventListener("visibilitychange", onVisibility);
+      media.removeEventListener?.("change", onMotionChange);
+    };
+  }, [active]);
+
+  return (
+    <section className="mt-16 w-full" aria-label="Interactive flow simulation">
+      <div className="mb-3 flex items-end justify-between gap-4">
+        <div>
+          <p className="text-[10px] tracking-[0.28em] text-[var(--muted)] uppercase">
+            Interactive Flow Field
+          </p>
+          <p className="mt-1 text-xs text-[var(--muted)]">
+            2D incompressible Navier–Stokes · move the body
+          </p>
+        </div>
+        <span className="hidden text-[9px] tracking-[0.2em] text-[var(--muted)] uppercase sm:block">
+          Uniform flow →
+        </span>
+      </div>
+      <div
+        ref={wrapperRef}
+        className="relative h-[260px] w-full overflow-hidden border border-[var(--border)] bg-[var(--surface)] touch-none sm:h-[300px]"
+      >
+        <canvas ref={canvasRef} className="absolute inset-0 h-full w-full" />
+      </div>
+    </section>
+  );
+}
