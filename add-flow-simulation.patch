--- /dev/null
+++ b/src/components/panels/FlowSimulation.tsx
@@ -0,0 +1,184 @@
+"use client";
+
+import { useEffect, useRef } from "react";
+
+/**
+ * Live streamline simulation: uniform left-to-right flow around a circular
+ * obstacle, using the classic closed-form 2D potential-flow solution
+ * (uniform flow + doublet). This is real analytic flow physics, not a
+ * pre-baked animation — the field is re-evaluated every frame from the
+ * obstacle's current position, so it reacts instantly as you move it.
+ *
+ * Complex potential: w(z) = U(z + R²/z), giving:
+ *   u = U·(1 − R²·(dx² − dy²) / (dx² + dy²)²)
+ *   v = −U·2R²·dx·dy / (dx² + dy²)²
+ * where dx, dy are the position relative to the cylinder center.
+ *
+ * Particles are advected by this field frame-to-frame and drawn with a
+ * fading trail (via a translucent overlay instead of a hard clear), which
+ * traces out the streamlines organically over a few seconds.
+ */
+
+const PARTICLE_COUNT = 260;
+const FREESTREAM_SPEED = 55; // px/sec
+const TRAIL_RGB = "143, 163, 176"; // matches --accent
+
+type Particle = {
+  x: number;
+  y: number;
+};
+
+export function FlowSimulation() {
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+
+  useEffect(() => {
+    const canvas = canvasRef.current;
+    if (!canvas) return;
+    const ctx = canvas.getContext("2d");
+    if (!ctx) return;
+
+    let width = 0;
+    let height = 0;
+    let dpr = 1;
+    let radius = 0;
+
+    // Obstacle center; smoothly chases the pointer while hovering.
+    let obstacleX = 0;
+    let obstacleY = 0;
+    let targetX = 0;
+    let targetY = 0;
+    let hovering = false;
+
+    const resize = () => {
+      dpr = Math.min(window.devicePixelRatio || 1, 2);
+      width = canvas.clientWidth;
+      height = canvas.clientHeight;
+      canvas.width = width * dpr;
+      canvas.height = height * dpr;
+      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+      radius = Math.max(18, Math.min(width, height) * 0.14);
+      if (obstacleX === 0 && obstacleY === 0) {
+        obstacleX = width / 2;
+        obstacleY = height / 2;
+        targetX = obstacleX;
+        targetY = obstacleY;
+      }
+      ctx.fillStyle = "rgba(7, 8, 9, 1)";
+      ctx.fillRect(0, 0, width, height);
+    };
+    resize();
+    window.addEventListener("resize", resize);
+
+    const onPointerMove = (e: PointerEvent) => {
+      const rect = canvas.getBoundingClientRect();
+      const margin = radius * 1.4;
+      targetX = Math.min(
+        width - margin,
+        Math.max(margin, e.clientX - rect.left),
+      );
+      targetY = Math.min(
+        height - margin,
+        Math.max(margin, e.clientY - rect.top),
+      );
+      hovering = true;
+    };
+    const onPointerLeave = () => {
+      hovering = false;
+    };
+    canvas.addEventListener("pointermove", onPointerMove);
+    canvas.addEventListener("pointerleave", onPointerLeave);
+
+    function spawnParticle(): Particle {
+      return { x: 0, y: Math.random() * height };
+    }
+
+    let particles: Particle[] = Array.from({ length: PARTICLE_COUNT }, () => {
+      const p = spawnParticle();
+      p.x = Math.random() * width; // spread out on first paint
+      return p;
+    });
+
+    function velocityAt(x: number, y: number): [number, number] {
+      const dx = x - obstacleX;
+      const dy = y - obstacleY;
+      const distSq = dx * dx + dy * dy;
+      const minSq = radius * radius * 1.02;
+      if (distSq < minSq) return [0, 0]; // inside/at the body
+
+      const r2 = radius * radius;
+      const denom = distSq * distSq;
+      const u = FREESTREAM_SPEED * (1 - (r2 * (dx * dx - dy * dy)) / denom);
+      const v = (-FREESTREAM_SPEED * 2 * r2 * dx * dy) / denom;
+      return [u, v];
+    }
+
+    let rafId = 0;
+    let last = performance.now();
+
+    const render = (now: number) => {
+      const dt = Math.min(0.05, (now - last) / 1000);
+      last = now;
+
+      // Ease obstacle toward pointer target for a natural "dragged" feel.
+      if (hovering) {
+        obstacleX += (targetX - obstacleX) * 0.12;
+        obstacleY += (targetY - obstacleY) * 0.12;
+      }
+
+      // Fade previous frame instead of clearing — leaves short trails that
+      // trace the streamlines rather than showing disconnected dots.
+      ctx.fillStyle = "rgba(7, 8, 9, 0.14)";
+      ctx.fillRect(0, 0, width, height);
+
+      ctx.fillStyle = `rgba(${TRAIL_RGB}, 0.8)`;
+      for (const p of particles) {
+        const [u, v] = velocityAt(p.x, p.y);
+        p.x += u * dt;
+        p.y += v * dt;
+
+        const dx = p.x - obstacleX;
+        const dy = p.y - obstacleY;
+        const tooClose = dx * dx + dy * dy < radius * radius * 1.02;
+
+        if (p.x > width || p.x < -5 || tooClose || p.y < -20 || p.y > height + 20) {
+          Object.assign(p, spawnParticle());
+          continue;
+        }
+
+        ctx.fillRect(p.x, p.y, 1.6, 1.6);
+      }
+
+      // Draw the obstacle on top, solid.
+      ctx.beginPath();
+      ctx.arc(obstacleX, obstacleY, radius, 0, Math.PI * 2);
+      ctx.fillStyle = "rgba(7, 8, 9, 1)";
+      ctx.fill();
+      ctx.strokeStyle = `rgba(${TRAIL_RGB}, 0.9)`;
+      ctx.lineWidth = 1.5;
+      ctx.stroke();
+
+      rafId = requestAnimationFrame(render);
+    };
+    rafId = requestAnimationFrame(render);
+
+    return () => {
+      cancelAnimationFrame(rafId);
+      window.removeEventListener("resize", resize);
+      canvas.removeEventListener("pointermove", onPointerMove);
+      canvas.removeEventListener("pointerleave", onPointerLeave);
+      particles = [];
+    };
+  }, []);
+
+  return (
+    <div className="relative">
+      <p className="mb-2 text-[10px] tracking-[0.2em] text-[var(--muted)] uppercase">
+        Flow around a cylinder — move your cursor over it
+      </p>
+      <canvas
+        ref={canvasRef}
+        className="h-48 w-full touch-none rounded-md border border-[var(--border)] sm:h-56"
+      />
+    </div>
+  );
+}
