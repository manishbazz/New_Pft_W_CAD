From a88d830db46427d666bb71713bdb975e174e1eba Mon Sep 17 00:00:00 2001
From: manishbazz <manishbazz@users.noreply.github.com>
Date: Sun, 16 Aug 2026 19:33:05 +0000
Subject: [PATCH] Balance sound volumes: lower click, raise scramble tick

- Click was volume 0.4 with sustainVolume 0.8, notably louder than
  hover's 0.25 -> dropped to 0.22
- Scramble tick was volume 0.06, much quieter than hover -> raised to 0.14
---
 src/lib/uiSound.ts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/lib/uiSound.ts b/src/lib/uiSound.ts
index f57be29..978caef 100644
--- a/src/lib/uiSound.ts
+++ b/src/lib/uiSound.ts
@@ -43,7 +43,7 @@ export function playClickTick() {
   loadZzfx()?.then(({ zzfx }) => {
     // volume, randomness, freq, attack, sustain, release, shape(saw),
     // shapeCurve, slide(descending), ..., noise, ..., sustainVolume, decay
-    zzfx(0.4, 0.05, 340, 0, 0.02, 0.13, 2, 1.1, -28, 0, 0, 0, 0, 0.08, 0, 0, 0, 0.8, 0.05);
+    zzfx(0.22, 0.05, 340, 0, 0.02, 0.13, 2, 1.1, -28, 0, 0, 0, 0, 0.08, 0, 0, 0, 0.8, 0.05);
   });
 }
 
@@ -63,6 +63,6 @@ export function playIntroChime() {
 export function playScrambleTick() {
   loadZzfx()?.then(({ zzfx }) => {
     const freq = 900 + Math.random() * 500;
-    zzfx(0.06, 0, freq, 0, 0.004, 0.012, 1, 1, 0, 0, 0, 0, 0, 0);
+    zzfx(0.14, 0, freq, 0, 0.004, 0.012, 1, 1, 0, 0, 0, 0, 0, 0);
   });
 }
-- 
